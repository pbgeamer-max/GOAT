# ==============================================================================
# 🐐 GOAT SERVERS - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ======================== SERVER & WEB CONFIG ========================
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000
SESSION_SECRET=goat-servers-super-secret-key-2026-rust-gaming

# ======================== STEAM AUTHENTICATION ========================
# 1. Get your Steam API Key at: https://steamcommunity.com/dev/apikey
# 2. Realm & ReturnURL must match your website domain/port
STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY_HERE
STEAM_REALM=http://localhost:3000/
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return

# ======================== DISCORD OAUTH2 (LINKING) ========================
# Create an App at: https://discord.com/developers/applications
# Under OAuth2 -> General: Add Redirect URL: http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# ======================== DISCORD BOT CONFIG ========================
# Bot Token from: https://discord.com/developers/applications -> Bot -> Reset Token
# Enable Privileged Gateway Intents: Server Members Intent & Message Content Intent
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
GUILD_ID=YOUR_DISCORD_GUILD_SERVER_ID

# Role ID given to verified players (Right-click role -> Copy Role ID)
DISCORD_VERIFIED_ROLE_ID=YOUR_VERIFIED_ROLE_ID

# Channel where the bot logs account link events (Embed with Steam + Discord info)
DISCORD_LOG_CHANNEL_ID=YOUR_VERIFY_LOGS_CHANNEL_ID

# Channel where the bot posts & auto-refreshes live server status embed (Optional)
STATUS_CHANNEL_ID=YOUR_STATUS_EMBED_CHANNEL_ID

# Voice channel renamed dynamically to "🟢 45/100" (Optional)
VOICE_CHANNEL_ID=YOUR_VOICE_CHANNEL_ID

# Discord Invite Link for website buttons
DISCORD_INVITE_URL=https://discord.gg/goat5x

# ======================== RUST SERVER & RCON ========================
# Rust Server Public IP & Ports
RUST_SERVER_IP=168.100.161.129
SERVER_PORT=28056
QUERY_PORT=28057
SERVER_NAME=GOAT 5X

# RCON Configuration (For automated in-game linking & /kit discord unlocking)
RUST_RCON_PORT=28058
RUST_RCON_PASSWORD=YOUR_RCON_PASSWORD_HERE
RCON_ENABLED=true

# Oxide / uMod In-Game Kit Grant Command
# {STEAM_ID} will be automatically replaced with player's SteamID64
RUST_KIT_COMMAND=oxide.grant user {STEAM_ID} kits.discord

# Wipe Cycle & Schedule display
NEXT_WIPE_DATE=2026-08-27T17:00:00Z
WIPE_CYCLE=Weekly Thursday Wipe @ 5:00 PM (17:00)

# ======================== POLLING & SYNC TIMERS ========================
POLL_INTERVAL_MS=30000
VOICE_SYNC_MS=60000
QUERY_TIMEOUT_MS=6000
PRESENCE_MIN_MS=30000
VOICE_MIN_RENAME_MS=300000

# ======================== BATTLEMETRICS (OPTIONAL) ========================
BM_API_KEY=
BM_SERVER_ID=
